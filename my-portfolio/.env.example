# Every value here is OPTIONAL. The dashboard degrades gracefully when a
# service is not configured (the row shows "—" or "unavailable").
# Copy to `.env.local` for local dev; set the same keys in the Vercel project.

# --- GitHub -----------------------------------------------------------------
# Without a token the /api/github route uses the public API (60 req/hr/IP,
# fine behind the 1h cache). A fine-grained read-only token raises the limit
# AND unlocks the contribution heatmap (needs the GraphQL API).
GITHUB_TOKEN=

# --- Vercel deploy status (optional) --------------------------------------
# Shows a live "deploy: ready · 2h ago" row. Create a token at
# vercel.com/account/tokens. Project ID is on the project's Settings page.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=   # only if the project lives under a team

# --- Spotify (now playing + top artist) --------------------------------
# 1. Create an app at https://developer.spotify.com/dashboard
#    Add redirect URI:  http://127.0.0.1:8888/callback
# 2. Copy the Client ID / Secret below.
# 3. Run `node scripts/spotify-token.mjs` once — it opens a browser, you
#    approve (scopes: currently-playing, recently-played, top-read), and it
#    prints the refresh token to paste here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Reading / watching / playing + favourites ------------------------
# URL of your tracker site's JSON status endpoint. Expected response shape
# (every field optional; `favourites.*` are ARRAYS — ties are all returned):
# {
#   "reading":  { "title": "...", "detail": "author?", "progress": 0-100 },
#   "watching": { "title": "...", "detail": "..." },
#   "playing":  { "title": "...", "detail": "..." },
#   "favourites": {
#     "album":  [{ "title": "...", "detail": "artist?" }],
#     "film":   [{ "title": "...", "detail": "year?" }],
#     "series": [{ "title": "..." }],
#     "game":   [{ "title": "..." }],
#     "book":   [{ "title": "...", "detail": "author?" }]
#   }
# }
# In Anti-social this is /api/status — set STATUS_USER + STATUS_TOKEN there,
# and TRACKER_STATUS_TOKEN here must equal that STATUS_TOKEN.
TRACKER_STATUS_URL=
TRACKER_STATUS_TOKEN=
